{
    "name": "kml-canvas-viewer",
    "version": "1.0.0",
    "description": "KML Viewer using HTML5 Canvas and OpenStreetMap",
    "scripts": {
        "start": "node server.js",
        "import:gpx": "node scripts/import-gpx-directory.js",
        "import:user-gpx": "node scripts/import-user-gpx-directory.js",
        "backfill:tile17": "node scripts/backfill-trail-tile17.js",
        "refresh:all": "npm run import:gpx && npm run import:user-gpx && npm run backfill:tile17",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "keywords": [
        "kml",
        "maps",
        "canvas"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "eslint": "^10.8.1",
        "http-server": "^14.1.1",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0"
    },
    "dependencies": {
        "@capacitor/android": "^8.0.1",
        "@capacitor/cli": "^8.0.1",
        "@capacitor/core": "^8.0.1",
        "cors": "^2.8.6",
        "express": "^4.22.1",
        "pg": "^8.23.0",
        "xmldom": "^0.6.0"
    }
}
