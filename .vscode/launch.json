{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Run KmlViewer Server",
            "program": "${workspaceFolder}/server.js",
            "cwd": "${workspaceFolder}",
            "env": {
                "PORT": "5174"
            },
            "console": "integratedTerminal"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open KmlViewer in Chrome",
            "url": "http://localhost:5174",
            "webRoot": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Run KmlViewer",
            "configurations": [
                "Run KmlViewer Server",
                "Open KmlViewer in Chrome"
            ]
        }
    ]
}
